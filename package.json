{
  "name": "dsh-acp-window-guard",
  "version": "0.3.0",
  "type": "module",
  "description": "DeepSeek Harness + billion-context(ACP) 的窗口/通道护栏：抬 modelContextLimit、重打超窗保险补丁、并在 fetch 层把模型请求钉到 ACP /bili/ 通道，防止手机等旁路轮次裸发导致 prompt is too long。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "billion-context",
    "acp",
    "context-window",
    "prompt-too-long"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumid0uce/dsh-acp-window-guard.git"
  },
  "scripts": {
    "check": "node --check lib/index.js"
  }
}